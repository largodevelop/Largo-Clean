{
  "name": "largo-clean",
  "version": "0.1.0",
  "description": "Largo Clean — анализ диска, очистка и неиспользуемые приложения",
  "main": "electron/main.js",
  "author": "Largo Develop",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win dir"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "dev.largo.clean",
    "productName": "Largo Clean",
    "directories": { "output": "release" },
    "files": ["electron/**/*", "package.json", "public/**/*"],
    "asar": true,
    "asarUnpack": ["electron/scanner.cs"],
    "win": {
      "target": [{ "target": "dir", "arch": ["x64"] }],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    }
  }
}

{
  "name": "largo-clean",
  "version": "0.3.3",
  "description": "Largo Clean — анализ диска, очистка и неиспользуемые приложения",
  "main": "electron/main.js",
  "author": "Largo Develop",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build": "npm run build:native && electron-builder --win dir",
    "release": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/release.ps1",
    "build:native": "dotnet build native/sensors/LargoSensors.csproj -c Release -o bin/sensors"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "rcedit": "^5.0.2"
  },
  "build": {
    "appId": "dev.largo.clean",
    "productName": "Largo Clean",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "package.json",
      "public/**/*"
    ],
    "asar": true,
    "asarUnpack": [
      "electron/scanner.cs"
    ],
    "win": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false,
      "requestedExecutionLevel": "requireAdministrator"
    },
    "afterPack": "scripts/after-pack.js",
    "extraResources": [
      {
        "from": "bin",
        "to": "bin",
        "filter": [
          "**/*",
          "!**/*.pdb"
        ]
      }
    ]
  },
  "dependencies": {
    "koffi": "^3.3.3"
  }
}